# Maintainer: Ami <ami@eonic.cloud>
# Contributor: Built by Bots <https://github.com/eonicman>

pkgname=pinscher
pkgver=0.9.4
pkgrel=1
pkgdesc="Hardware orchestration layer — probe, diagnose, and lint boot-critical hardware"
arch=('x86_64')
url="https://github.com/eonicman/pinscher"
license=('MIT')
depends=('glibc' 'pciutils' 'kmod')
makedepends=('go')
optdepends=('hwdata: PCI/USB ID database for human-readable device names'
             'iw: detailed WiFi capability detection')
source=("$pkgname-$pkgver.tar.gz::https://github.com/eonicman/pinscher/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')  # Replace with actual hash on release

build() {
  cd "$pkgname-$pkgver"
  go build -ldflags="-s -w -X main.version=$pkgver" -o pinscher ./cmd/pinscher/
}

check() {
  cd "$pkgname-$pkgver"
  go test ./...
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 pinscher "$pkgdir/usr/bin/pinscher"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"
  install -Dm644 dist/pinscher-boot-check.service "$pkgdir/usr/lib/systemd/system/pinscher-boot-check.service"
  install -Dm644 dist/pinscher-boot-check.timer "$pkgdir/usr/lib/systemd/system/pinscher-boot-check.timer"
  install -Dm644 dist/pinscher-mkinitcpio-hook "$pkgdir/usr/lib/initcpio/hooks/pinscher"
  install -Dm755 dist/pinscher-mkinitcpio-install "$pkgdir/usr/lib/initcpio/install/pinscher" 2>/dev/null || true
}