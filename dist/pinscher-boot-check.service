[Unit]
Description=Pinscher Hardware Orchestration Layer
Documentation=https://github.com/eonicman/pinscher
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/bin/pinscher lint-boot --json
ExecStart=/usr/bin/pinscher report --json
# Use StandardOutput=append to log to journal
StandardOutput=journal
StandardError=journal

# Run as root to access all sysfs paths
# For read-only operations (report, lint-boot, diagnose, get), no root needed
# For write operations (set, apply), root is required
#User=root

[Install]
WantedBy=multi-user.target