[Unit]
Description=Pinscher Boot Hardware Check
Documentation=https://github.com/eonicman/pinscher
After=multi-user.target

[Service]
Type=oneshot
# Run lint-boot, report, profile recommendations, and quirk check
ExecStartPre=/bin/mkdir -p /var/log/pinscher
ExecStart=/usr/bin/pinscher lint-boot --json
ExecStart=/usr/bin/pinscher report --json
ExecStart=/usr/bin/pinscher profile recommend --json
StandardOutput=append:/var/log/pinscher/boot-check.log
StandardError=append:/var/log/pinscher/boot-check.log

# Run as root to access all sysfs paths
# For read-only operations (report, lint-boot, diagnose, get), no special privileges needed beyond sysfs read
# For write operations (set, apply), root is required

[Install]
WantedBy=multi-user.target